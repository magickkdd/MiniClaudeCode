LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-chat
PROJECT_ROOT=.
MAX_TURNS=25
BASH_TIMEOUT=60
TRACE_PATH=.traces/session.jsonl

# 本地三引擎（实测见 docs/inference-bench.md，跑法见 scripts/bench_engines.py）。
# 三个都暴露 OpenAI 兼容 /v1/chat/completions，换引擎只改这三行；真实环境变量优先于本文件。
#   Ollama     LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5:1.5b-instruct-q4_K_M
#   llama.cpp  LLM_BASE_URL=http://localhost:8080/v1    LLM_MODEL=<GGUF 的绝对路径>
#               llama-server 不给 --alias 时，/v1/models 报回来的 id 就是那条路径本身，
#              LLM_MODEL 必须逐字填它 —— 填 "qwen2.5-1.5b-instruct-q4_k_m" 会 404。
#   vLLM       LLM_BASE_URL=http://localhost:8000/v1    LLM_MODEL=<vllm serve 传的模型路径>
#              同一张 4G 卡上三个引擎互斥，跑完一个关一个。

# 下面两项都可以不设（默认值见 README §4.5）。MCP_SERVERS 留空 = 一个外部工具都不接。
# 每项 {"name","endpoint","args","env"}：endpoint 是可执行文件，args 是它的参数，
# env 是**点名要透传**给那个子进程的环境变量名 —— 不点名的都不给，密钥因此不会自己漏出去。
# MCP_SERVERS=[{"name":"fx","endpoint":"python","args":["server.py"],"env":["TOKEN"]}]
# SKILLS_DIR=skills
